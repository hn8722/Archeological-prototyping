generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                         String        @id
  name                       String
  snapshot                   String
  isGroup                    Boolean       @default(false)
  isPublic                   Boolean       @default(false)
  ownerId                    String?
  workshopCode               String?       @unique
  workshopStatus             String        @default("draft")
  workshopAllowReadAfterClose Boolean      @default(true)
  workshopAllowAi            Boolean       @default(true)
  workshopClosedAt           DateTime?
  stories                    StoryDraft[]
  members                    GroupMember[]
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@index([isGroup])
  @@index([ownerId])
  @@index([isPublic])
  @@index([workshopCode])
  @@index([workshopStatus])
}

model StoryDraft {
  id        String   @id @default(cuid())
  sessionId String
  content   String
  model     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model GroupMember {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}
