generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                         String        @id
  name                       String
  snapshot                   String
  isGroup                    Boolean       @default(false)
  isPublic                   Boolean       @default(false)
  ownerId                    String?
  workshopCode               String?       @unique
  workshopStatus             String        @default("draft")
  workshopAllowReadAfterClose Boolean      @default(true)
  workshopAllowAi            Boolean       @default(true)
  workshopClosedAt           DateTime?
  stories                    StoryDraft[]
  members                    GroupMember[]
  workshopParticipants       WorkshopParticipant[]
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@index([isGroup])
  @@index([ownerId])
  @@index([isPublic])
  @@index([workshopCode])
  @@index([workshopStatus])
}

model WorkshopParticipant {
  id         String    @id @default(cuid())
  sessionId  String
  name       String
  tokenHash  String    @unique
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime?
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([joinedAt])
}

model StoryDraft {
  id        String   @id @default(cuid())
  sessionId String
  content   String
  model     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model GroupMember {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model EditLock {
  id         String   @id @default(cuid())
  sessionId  String
  generation Int
  kind       String
  entryId    String
  entryIndex Int
  ownerId    String
  ownerLabel String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, generation, kind, entryId, entryIndex])
  @@index([ownerId])
  @@index([expiresAt])
}
